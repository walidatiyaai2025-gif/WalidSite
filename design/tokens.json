{
  "meta": {
    "version": "6.0",
    "language": [
      "ar",
      "en"
    ],
    "sourceOfTruth": "design/tokens.json",
    "notes": "Desktop light-first, RTL & LTR; app dark mode is optional extension; no font files bundled."
  },
  "color": {
    "brand": {
      "primary": "#163B66",
      "cta": "#126DE1",
      "accent": "#00A999"
    },
    "surface": {
      "base": "#FFFFFF",
      "subtle": "#F5F9FC",
      "muted": "#EAF5FB",
      "elevated": "#FFFFFF"
    },
    "text": {
      "strong": "#142E4D",
      "body": "#315471",
      "muted": "#55718B",
      "inverse": "#FFFFFF"
    },
    "border": {
      "soft": "#D3E3ED",
      "strong": "#97B4C8"
    },
    "semantic": {
      "success": "#179B67",
      "warning": "#BF7F12",
      "danger": "#C53F4B",
      "info": "#126DE1"
    }
  },
  "typography": {
    "arabic": "Tajawal, Arial, sans-serif",
    "latin": "Inter, Arial, sans-serif",
    "scalePx": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 20,
      "xl": 26,
      "xxl": 36,
      "hero": 52
    },
    "lineHeight": {
      "body": 1.6,
      "heading": 1.24
    }
  },
  "spacePx": [
    0,
    4,
    8,
    12,
    16,
    20,
    24,
    32,
    40,
    48,
    64
  ],
  "radiusPx": {
    "sm": 6,
    "md": 12,
    "lg": 18,
    "xl": 26,
    "pill": 999
  },
  "breakpointsPx": {
    "mobile": 0,
    "tablet": 768,
    "desktop": 1200,
    "wide": 1536
  },
  "layout": {
    "maxContentPx": 1260,
    "appTapTargetMinPx": 44,
    "desktopGrid": 12,
    "mobileGrid": 4
  },
  "motion": {
    "shortMs": 120,
    "standardMs": 220,
    "longMs": 320,
    "respectReducedMotion": true
  },
  "statusStates": [
    "loading",
    "empty",
    "success",
    "error",
    "offline",
    "unauthorized",
    "rate-limited"
  ],
  "accessibility": {
    "target": "WCAG 2.2 AA",
    "minimumTargetCssPx": 24,
    "preferredTouchPx": 44,
    "keyboardNavigation": true,
    "rtlTest": true,
    "reducedMotion": true
  }
}
