{
  "version": "6.0",
  "status": "DESIGN_CONTRACT_NOT_APPLIED",
  "database": "MariaDB 10.11+ target subject to deployment verification",
  "idStrategy": "UUID 36-char canonical; model migrations must preserve key contracts",
  "tables": [
    {
      "table": "users",
      "columns": [
        "id:uuid:pk",
        "email:varchar(254):unique",
        "password_hash:varchar(255):nullable",
        "status:varchar(20)",
        "created_at:datetime"
      ]
    },
    {
      "table": "profiles",
      "columns": [
        "id:uuid:pk",
        "user_id:uuid:fk(users)",
        "public_name:varchar(140)",
        "bio_en:text",
        "bio_ar:text",
        "portrait_asset_id:uuid:nullable",
        "publish_status:varchar(20)"
      ]
    },
    {
      "table": "career_positions",
      "columns": [
        "id:uuid:pk",
