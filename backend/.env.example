APP_NAME="Waleed Site"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=ar
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Portfolio contact requires verified production delivery. Disabled by default.
MAIL_MAILER=log
MAIL_CONTACT_RECIPIENT=
MAIL_FROM_ADDRESS=


# First-run wizard: set 32+ random character token in private server .env.
# Do not enable without APP_KEY, a provisioned database and HTTPS.
SITE_SETUP_ENABLED=false
SITE_SETUP_TOKEN=
# Owner-only panel applies reviewed/deployed Laravel migrations, not PHP ZIPs.
SITE_UPDATES_ENABLED=true
# Opt-in host-scheduler migrations after a trusted code deploy + DB backup.
SITE_AUTO_MIGRATE=false
SITE_RELEASE_REF=unidentified
