APP_NAME="Waleed Site"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=ar
LOG_CHANNEL=stack
LOG_LEVEL=debug
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Portfolio contact requires verified production delivery. Disabled by default.
MAIL_MAILER=log
MAIL_CONTACT_RECIPIENT=
MAIL_FROM_ADDRESS=


# New cPanel installation: /setup generates APP_KEY and a private setup token automatically.
# Read the one-time token from storage/app/site-first-run.json via cPanel File Manager.
# No Terminal or manual .env editing required for first installation.
SITE_SETUP_ENABLED=false
SITE_SETUP_TOKEN=
SITE_SETUP_DATABASE_READY=false
# Owner-only panel applies reviewed/deployed Laravel migrations, not PHP ZIPs.
SITE_UPDATES_ENABLED=true
# Opt-in host-scheduler migrations after a trusted code deploy + DB backup.
SITE_AUTO_MIGRATE=false
SITE_RELEASE_REF=unidentified
